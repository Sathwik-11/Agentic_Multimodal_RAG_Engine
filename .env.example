OPENAI_API_KEY=sk-your-key

# Chat + embeddings
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Chunking (aligned with the embedding tokenizer)
CHUNK_MAX_TOKENS=512

# Chroma
CHROMA_DIR=./chroma_db
COLLECTION_NAME=agentic_rag

# Retrieval / CRAG
# RETRIEVE_CANDIDATE_K is pulled from BM25 and dense search before FlashRank.
RETRIEVE_K=5
RETRIEVE_CANDIDATE_K=20
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
FLASHRANK_MODEL=ms-marco-MiniLM-L-12-v2
MAX_RETRIES=2
MAX_HISTORY_MESSAGES=20

# Optional: Tavily web search fallback when vector retrieval fails
# TAVILY_API_KEY=

# Optional: persist LangGraph conversation state across restarts
# CHECKPOINT_PATH=./checkpoints/rag.sqlite

# NeMo Guardrails (input jailbreak/safety + output/fact check)
GUARDRAILS_ENABLED=true
# GUARDRAILS_DIR=./guardrails

# RAGAS per-turn scores (faithfulness, answer relevancy). No gold answers required.
RAGAS_ENABLED=true
# Replace the answer when faithfulness falls below this (0 = never replace)
RAGAS_MIN_FAITHFULNESS=0
